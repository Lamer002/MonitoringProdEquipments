/* MonitoringProdEquipment — dark operational dashboard */
QWidget {
    background-color: #0b1220;
    color: #e2e8f0;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 14px;
}
QMainWindow, QDialog { background-color: #0b1220; }
QLabel { background: transparent; }
QLabel#labelTitle {
    color: #f8fafc;
    font-size: 27px;
    font-weight: 700;
}
QLabel#labelSubtitle, QLabel#labelHint {
    color: #94a3b8;
    font-size: 13px;
}
QLabel#labelSummary {
    color: #38bdf8;
    font-size: 14px;
    font-weight: 600;
}
QGroupBox {
    border: 1px solid #273449;
    border-radius: 14px;
    background-color: #111c2c;
    margin-top: 16px;
    padding: 12px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 17px;
    padding: 0 8px;
    color: #cbd5e1;
}
QListWidget, QTableView, QLineEdit {
    background-color: #0e1929;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 9px;
    selection-background-color: #1e40af;
    selection-color: #f8fafc;
}
QListWidget::item {
    padding: 12px 10px;
    margin: 3px;
    border-radius: 8px;
}
QListWidget::item:hover { background-color: #1e293b; }
QListWidget::item:selected { background-color: #1d3557; }
QPushButton {
    background-color: #23334a;
    border: 1px solid #3a4e68;
    border-radius: 9px;
    color: #f1f5f9;
    padding: 11px 18px;
    font-weight: 600;
    min-height: 23px;
}
QPushButton:hover { background-color: #314763; }
QPushButton:pressed { background-color: #15243a; }
QPushButton:disabled {
    background-color: #172235;
    border-color: #23334a;
    color: #64748b;
}
QPushButton#pushButtonAddMachine,
QPushButton#pushButtonStart,
QPushButton#pushButtonAddInList {
    background-color: #0284c7;
    border-color: #0ea5e9;
    color: white;
}
QPushButton#pushButtonAddMachine:hover,
QPushButton#pushButtonStart:hover,
QPushButton#pushButtonAddInList:hover { background-color: #0369a1; }
QPushButton#pushButtonDeleteMachine,
QPushButton#pushButtonStop { background-color: #7f1d1d; border-color: #b91c1c; }
QPushButton#pushButtonDeleteMachine:hover,
QPushButton#pushButtonStop:hover { background-color: #991b1b; }
QProgressBar {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    height: 20px;
    text-align: center;
}
QProgressBar::chunk { background-color: #38bdf8; border-radius: 7px; }
QHeaderView::section {
    background-color: #1e293b;
    color: #e2e8f0;
    border: none;
    padding: 8px;
}
QTableView { gridline-color: #334155; alternate-background-color: #152238; }
QScrollBar:vertical { background: #0e1929; width: 11px; }
QScrollBar::handle:vertical { background: #475569; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
